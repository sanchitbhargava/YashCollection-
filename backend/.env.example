NODE_ENV=development
PORT=5000

MONGO_URI=mongodb://localhost:27017/yashcollection

JWT_SECRET=your_super_secret_jwt_key_change_in_production
JWT_EXPIRE=30d
JWT_COOKIE_EXPIRE=30

